universe = vanilla
executable = ./run_nominal_by_cat.sh
arguments = $(cat)

output = condor/logs/bias_$(cat).out
error  = condor/logs/bias_$(cat).err
log    = condor/logs/bias_$(cat).log

transfer_input_files = RunBiasStudy.py,/uscms_data/d3/esledge/fits-hmm/CMSSW_14_1_0_pre4/src/flashggFinalFit/Combine/Datacard_tutorial_$(cat)_mu_inclusive.root
should_transfer_files = YES
when_to_transfer_output = ON_EXIT

queue cat in ggHcat5